# Copy this file to ".env.local" and change the values for your machine.

# Where the backend API lives. Leave as /api to use the Vite proxy below.
VITE_API_BASE_URL=/api

# "true" = use the built-in fake API with the sample data (no backend needed).
# Set to "false" once the real backend is running.
VITE_USE_MOCKS=true

# Only used when VITE_USE_MOCKS=false: the backend address the dev server forwards /api to.
API_PROXY_TARGET=http://localhost:8000

# Only used when VITE_USE_MOCKS=false. "fastapi" = the FastAPI server in backend/ (translated
# automatically); "contract" = a backend that follows docs/api-contract.md exactly.
VITE_BACKEND=fastapi

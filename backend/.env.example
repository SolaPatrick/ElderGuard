# Copy this file to .env and fill it in. Never put the real .env in git.

# PostgreSQL connection
ELDERGUARD_DB='postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/elderguard'

# Signs login tokens. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
ELDERGUARD_SECRET='PASTE_THE_GENERATED_KEY_HERE'

# Uncomment on a development computer to turn on the /docs pages. Leave off anywhere else.
# ELDERGUARD_DOCS=1
